<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MovieBox" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/moviebox_primary</item>
        <item name="colorPrimaryVariant">@color/moviebox_primary_variant</item>
        <item name="colorOnPrimary">@color/moviebox_on_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/moviebox_secondary</item>
        <item name="colorSecondaryVariant">@color/moviebox_secondary_variant</item>
        <item name="colorOnSecondary">@color/moviebox_on_secondary</item>

        <!-- Surface colors. -->
        <item name="colorSurface">@color/moviebox_surface</item>
        <item name="colorOnSurface">@color/moviebox_on_surface</item>
        <item name="colorSurfaceVariant">@color/moviebox_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/moviebox_on_surface_variant</item>

        <!-- Background -->
        <item name="colorBackground">@color/moviebox_background</item>
        <item name="colorOnBackground">@color/moviebox_on_background</item>

        <!-- Error -->
        <item name="colorError">@color/moviebox_error</item>
        <item name="colorOnError">@color/moviebox_on_error</item>

        <!-- Custom -->
        <item name="colorOutline">@color/moviebox_outline</item>
    </style>

    <style name="Theme.MovieBox.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MovieBox.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.MovieBox.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>